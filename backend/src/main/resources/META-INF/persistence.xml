<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="octobird" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.openelements.octobird.persistence.entity.RepoConfigEntity</class>
        <class>com.openelements.octobird.persistence.entity.GitHubAccountEntity</class>
        <class>com.openelements.octobird.persistence.entity.MentorAccountEntity</class>
        <class>com.openelements.octobird.persistence.entity.ReminderStateEntity</class>
        <class>com.openelements.octobird.persistence.entity.AuditLogEntity</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
